#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated test font extracts (large; rebuild with the screenshot pipeline)
test/fonts/

# Golden test diff dumps (regenerated whenever a comparison fails)
test/failures/

# Importer cache: JMdict + Tanos sources fetched by tools/build_dict.dart
tools/_cache/
# Working copy from tools/build_jmdict_sidecar.dart (uncompressed sqlite).
tools/_build/

# Sidecar artifacts: pushed to Raffaelbdl/iuna-data:main by
# tools/release_sidecar.sh, not bundled into the APK. The runtime
# downloads them on demand.
assets/db/jmdict.sqlite.gz
assets/db/jmdict.version
assets/db/jmdict.LICENSE.txt

linux/
packs/dist/

# Anki decks fed to tools/build_science_pack.dart.
*.apkg

# Signing and service credentials — never commit these.
*.jks
*.keystore
key.properties
google-services.json

# Personal, machine-specific agent notes.
CLAUDE.local.md
