<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background. Matches the gold→pink diagonal of the
  Home screen's HeroPack so the launcher tile reads as Iuna at a
  glance. Angle 315 = top-left → bottom-right (Android's "0 is left
  to right, 90 is bottom to top" convention).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFD994"
        android:endColor="#F3A7B5"/>
</shape>
